# Gemini API key — read server-side by server.ts via process.env.GEMINI_API_KEY.
# Copy this file to `.env.local` and fill in your real key for local development.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Numero WhatsApp di gestione ordini con prefisso internazionale e senza spazi (es. 393331234567)
VITE_WHATSAPP_MANAGEMENT_NUMBER=

